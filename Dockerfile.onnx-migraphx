# Build environment for voxtype ONNX MIGraphX binary
# MUST be run on a machine with an AMD GPU
#
# pyke ort 2.0.0-rc.12 ships no ROCm/MIGraphX prebuilt — only cu12, cu13,
# wgpu, nvrtx, and CPU-only ("none"). The migraphx feature flag wires the
# EP into the binary but the runtime .so files (libonnxruntime_providers_*.so)
# come from a from-source ONNX Runtime build with --use_migraphx.
#
# This Dockerfile compiles ONNX Runtime 1.24.2 (matching the version pyke's
# rc.12 wraps) against AMD's ROCm SDK, then builds voxtype against that local
# ORT via ORT_LIB_LOCATION. Total build time: 45-60 minutes.
#
# The ONNX Runtime source comes from the project's mirror, pinned by sha256
# (see "Fetch ONNX Runtime" below). Its build still downloads the CMake
# dependencies listed in its cmake/deps.txt from their own GitHub
# repositories, each checked against the SHA1 in that file.
#
# Usage:
#   docker build -f Dockerfile.onnx-migraphx -t voxtype-onnx-migraphx-builder .
#   docker run --rm -v $(pwd)/releases:/output voxtype-onnx-migraphx-builder
#
# The resulting binary requires the bundled libonnxruntime_providers_migraphx.so
# and *_shared.so installed alongside the binary (handled by scripts/package.sh),
# plus AMD's ROCm runtime (rocm-libs / rocm-hip-runtime / migraphx) on the host.
#
# ROCm 7.2.2 — older 7.0.x bundles a MIGraphX without `fp4x2` shape type,
# which ORT 1.24.2's MIGraphX provider unconditionally references and
# fails to compile against.
FROM rocm/dev-ubuntu-24.04:7.2.2-complete

ARG VERSION=0.7.0
ARG ORT_VERSION=1.24.2
ARG DEBIAN_FRONTEND=noninteractive

ENV VERSION=${VERSION}
ENV ROCM_PATH=/opt/rocm
ENV PATH="/opt/rocm/bin:${PATH}"

# Retry apt. Acquire::Retries covers connection errors; the loop covers a 404
# or a size mismatch while an Ubuntu mirror is mid-sync.
RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\n' \
    > /etc/apt/apt.conf.d/80-voxtype-retries

# Install build dependencies for both ORT and voxtype.
# migraphx-dev is required so ORT's CMake find_package(migraphx) succeeds;
# it's not pulled in by the rocm/dev-ubuntu-24.04 base image even though
# rocm-hip-sdk and the runtime libs are.
RUN for attempt in 1 2 3 4; do apt-get update && apt-get install -y \
    curl \
    build-essential \
    clang \
    cmake \
    ninja-build \
    pkg-config \
    libasound2-dev \
    libx11-dev \
    libxi-dev \
    libxtst-dev \
    libgtk-3-dev \
    libglib2.0-dev \
    libappindicator3-dev \
    libssl-dev \
    protobuf-compiler \
    libprotobuf-dev \
    git \
    binutils \
    libvulkan-dev \
    glslang-tools \
    spirv-tools \
    libshaderc-dev \
    glslc \
    python3 \
    python3-pip \
    python3-numpy \
    python3-sympy \
    python3-flatbuffers \
    python3-packaging \
    migraphx-dev \
    && break; \
    [ "$attempt" = 4 ] && exit 1; \
    echo "apt failed (attempt $attempt), mirror may be syncing; retrying in 90s"; \
    if [ "$attempt" = 2 ]; then echo "switching apt to azure.archive.ubuntu.com"; sed -i -E 's#https?://(archive|security)\.ubuntu\.com#http://azure.archive.ubuntu.com#g' /etc/apt/sources.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true; fi; \
    rm -rf /var/lib/apt/lists/*; sleep 90; \
    done && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build

# Fetch ONNX Runtime's source from the project's mirror, pinned by sha256.
# This used to be a `git clone` of github.com/microsoft/onnxruntime, which
# returned 404 for hours on 2026-11-18 and failed this build. The archive is
# the unmodified tree of tag v1.24.2 without its submodules, none of which
# this build reads: --skip_submodule_sync is passed, ONNX comes from the
# archive pinned in cmake/deps.txt, and the other two are the WebAssembly
# toolchain and a fuzzing library. scripts/mirror-onnxruntime-inputs.sh
# builds it and pins the same hash. There is no second download location on
# purpose: one path, one hash. To build where the mirror is unreachable,
# serve the archive yourself and pass
# --build-arg VOXTYPE_BUILD_INPUTS_URL=<base url>; the pin is not a build
# argument, so any copy has to be the same bytes.
#
# ONNX Runtime's CMake writes `git log -1 --format=%h` and the branch name
# into its build info string, which ends up in the voxtype binary. The
# archive has no .git, so recreate what `git clone --depth 1` left behind:
# one commit object (shipped raw in the archive, and it has to hash to the
# pinned commit id) marked shallow, with a detached HEAD. The string stays
# "git-branch=HEAD, git-commit-id=058787c", which is what the 1.3.0-rc3 binary
# carries.
ARG VOXTYPE_BUILD_INPUTS_URL=https://models.voxtype.io/build-inputs
ENV ORT_SOURCE_SHA256=41f2cd14842a288887aeef5942d44eb4ce18f031db30bd1207eed120aa5edb69
ENV ORT_SOURCE_COMMIT=058787ceead760166e3c50a0a4cba8a833a6f53f
COPY scripts/ci/fetch-build-input.sh /usr/local/bin/fetch-build-input.sh
RUN set -eux; \
    bash /usr/local/bin/fetch-build-input.sh \
      "${VOXTYPE_BUILD_INPUTS_URL}/onnxruntime/v${ORT_VERSION}-source/onnxruntime-${ORT_VERSION}-source.tar.gz" \
      "${ORT_SOURCE_SHA256}" /tmp/ort-source.tar.gz; \
    mkdir /tmp/ort-source; \
    tar -xzf /tmp/ort-source.tar.gz --strip-components=1 -C /tmp/ort-source; \
    mv /tmp/ort-source/onnxruntime /build/onnxruntime; \
    cd /build/onnxruntime; \
    git init -q; \
    commit=$(git hash-object -t commit -w /tmp/ort-source/upstream-commit); \
    test "${commit}" = "${ORT_SOURCE_COMMIT}" \
      || { echo "FAIL: the archive's commit object is ${commit}, pinned ${ORT_SOURCE_COMMIT}."; exit 1; }; \
    echo "${commit}" > .git/shallow; \
    git update-ref --no-deref HEAD "${commit}"; \
    stamp="git-branch=$(git rev-parse --abbrev-ref HEAD), git-commit-id=$(git log -1 --format=%h)"; \
    test "${stamp}" = "git-branch=HEAD, git-commit-id=$(printf %.7s "${ORT_SOURCE_COMMIT}")" \
      || { echo "FAIL: ONNX Runtime would be stamped '${stamp}'."; exit 1; }; \
    rm -rf /tmp/ort-source /tmp/ort-source.tar.gz; \
    echo "ONNX Runtime ${ORT_VERSION} source staged at /build/onnxruntime (${stamp})."

# Build ONNX Runtime from source with MIGraphX EP.
# - --build_shared_lib produces libonnxruntime.so for the EP bridge.
# - FETCHCONTENT_TRY_FIND_PACKAGE_MODE=NEVER forces ORT to use its bundled
#   abseil-cpp/re2/protobuf instead of the system versions, which can have
#   ABI drift across patch releases (the original v0.6 ROCm/CUDA Dockerfiles
#   relied on pyke prebuilts so this wasn't an issue then).
RUN cd /build/onnxruntime \
    && ./build.sh \
        --config Release \
        --use_migraphx \
        --migraphx_home /opt/rocm \
        --rocm_home /opt/rocm \
        --build_shared_lib \
        --parallel \
        --skip_tests \
        --skip_submodule_sync \
        --allow_running_as_root \
        --cmake_extra_defines \
            onnxruntime_BUILD_UNIT_TESTS=OFF \
            FETCHCONTENT_TRY_FIND_PACKAGE_MODE=NEVER \
    && ls -la /build/onnxruntime/build/Linux/Release/libonnxruntime_providers_migraphx.so \
    && ls -la /build/onnxruntime/build/Linux/Release/libonnxruntime_providers_shared.so

ENV ORT_LIB_LOCATION=/build/onnxruntime/build/Linux/Release

# Copy voxtype source and build against the local ORT
COPY . /build/voxtype
WORKDIR /build/voxtype

# Disable LTO for faster builds. The single voxtype-onnx-migraphx binary
# bundles every ONNX engine, but MIGraphX EP registration only happens
# for Parakeet — every other ONNX engine runs on CPU because MIGraphX 7.2
# can't compile their graphs (per-engine notes in src/transcribe/*.rs and
# Cargo.toml). Cohere is held back until an int4/FP16 model variant ships.
RUN cargo build --release \
        --features parakeet-migraphx,moonshine,sensevoice,paraformer,dolphin,omnilingual,cohere,openvino-whisper,ml-diarization,gguf,cohere-gguf,parakeet-gguf \
        --config 'profile.release.lto=false' \
        --config 'profile.release.codegen-units=8' \
    && cp target/release/voxtype /tmp/voxtype-onnx-migraphx \
    && cargo build --release -p voxtype-gguf-worker --features vulkan \
        --config 'profile.release.lto=false' \
        --config 'profile.release.codegen-units=8' \
    && cp target/release/voxtype-gguf-worker /tmp/voxtype-gguf-worker

# Every release binary carries the GGUF client, and every x86_64 ONNX variant
# ships a Vulkan-capable worker (gguf_backend = "auto" falls back to the CPU
# when no Vulkan device initializes). See scripts/verify-gguf-companion.sh.
RUN scripts/verify-gguf-companion.sh --vulkan --haswell-floor --run \
        /tmp/voxtype-onnx-migraphx /tmp/voxtype-gguf-worker

# Copy companion provider .so files. ORT computes the .so search path from
# argv[0]'s dirname (NOT /proc/self/exe), so package.sh installs the binary
# and these .so files together under /usr/lib/voxtype/migraphx/.
RUN mkdir -p /tmp/onnx-migraphx-libs \
    && cp -L /build/onnxruntime/build/Linux/Release/libonnxruntime_providers_migraphx.so \
        /tmp/onnx-migraphx-libs/ \
    && cp -L /build/onnxruntime/build/Linux/Release/libonnxruntime_providers_shared.so \
        /tmp/onnx-migraphx-libs/

# Verify binary
RUN echo "=== Verifying ONNX MIGraphX binary ===" \
    && /tmp/voxtype-onnx-migraphx --version \
    && echo "=== Binary size ===" \
    && ls -lh /tmp/voxtype-onnx-migraphx \
    && echo "=== Companion .so files ===" \
    && ls -lh /tmp/onnx-migraphx-libs/

# Output stage: copy binary and companion .so files
CMD mkdir -p /output \
    && cp /tmp/voxtype-onnx-migraphx /output/voxtype-${VERSION}-linux-x86_64-onnx-migraphx \
    && cp /tmp/voxtype-gguf-worker /output/voxtype-${VERSION}-linux-x86_64-onnx-migraphx.gguf-worker \
    && cp /tmp/onnx-migraphx-libs/libonnxruntime_providers_migraphx.so /output/voxtype-${VERSION}-linux-x86_64-onnx-migraphx.libonnxruntime_providers_migraphx.so \
    && cp /tmp/onnx-migraphx-libs/libonnxruntime_providers_shared.so /output/voxtype-${VERSION}-linux-x86_64-onnx-migraphx.libonnxruntime_providers_shared.so \
    && echo "Output:" \
    && ls -la /output/voxtype-${VERSION}-linux-x86_64-onnx-migraphx*
