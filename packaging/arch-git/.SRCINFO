pkgbase = voxtype-git
	pkgdesc = Push-to-talk voice-to-text for Linux (development version)
	pkgver = 1.2.2.r7.g96a4277
	pkgrel = 1
	url = https://voxtype.io
	install = voxtype-git.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = clang
	makedepends = cmake
	makedepends = git
	makedepends = pkgconf
	makedepends = shaderc
	makedepends = spirv-headers
	makedepends = vulkan-headers
	makedepends = vulkan-icd-loader
	makedepends = gtk4
	makedepends = gtk4-layer-shell
	makedepends = wayland
	makedepends = libxkbcommon
	depends = alsa-lib
	depends = bash
	depends = curl
	depends = glibc
	depends = libgcc
	depends = libstdc++
	optdepends = wtype: keyboard simulation for Wayland (recommended, best CJK support)
	optdepends = dotool: keyboard simulation with layout support (KDE/GNOME compatible)
	optdepends = ydotool: keyboard simulation fallback (X11/TTY support)
	optdepends = wl-clipboard: Wayland clipboard support
	optdepends = xdotool: X11 keyboard simulation
	optdepends = xclip: X11 clipboard support
	optdepends = libnotify: desktop notifications
	optdepends = pipewire-alsa: ALSA compatibility for PipeWire
	optdepends = pulseaudio-alsa: ALSA compatibility for PulseAudio
	optdepends = vulkan-icd-loader: GPU acceleration for Whisper and GGUF models, and native OSD rendering
	optdepends = onnxruntime>=1.24.0: CPU inference for the ONNX engines
	optdepends = gtk4: GTK4 OSD frontend and meetings window
	optdepends = gtk4-layer-shell: GTK4 OSD frontend
	optdepends = cairo: GTK4 OSD frontend
	optdepends = glib2: GTK4 OSD frontend
	optdepends = wayland: native OSD frontend
	optdepends = libxkbcommon: native OSD frontend
	optdepends = libglvnd: OpenGL rendering for the native OSD frontend
	optdepends = quickshell: Quickshell OSD frontend
	optdepends = qt6-declarative: Quickshell OSD frontend
	optdepends = ollama: local AI summarization for meeting mode
	optdepends = libpulse: capture of the other side of a call in meeting mode (parec, pactl)
	optdepends = ffmpeg: meeting audio import, retention and playback
	optdepends = xdg-utils: open shared meetings and links from the meeting view
	optdepends = bubblewrap: sandbox for the meeting assistant
	provides = voxtype=1.2.2.r7.g96a4277
	conflicts = voxtype
	options = !lto
	options = !debug
