# Build environment for voxtype ONNX AVX-512 binary
# MUST be run on a machine with AVX-512 support (Zen 4+, some Intel)
#
# Uses Ubuntu 24.04 for glibc 2.39+ (required by ONNX Runtime prebuilt binaries).
# Building inside Docker caps the glibc requirement at 2.39, preventing the
# binary from picking up symbols from newer host glibc (e.g. 2.43 on Arch).
#
# Usage:
#   docker build -f Dockerfile.onnx-avx512 -t voxtype-onnx-avx512-builder .
#   docker run --rm -v $(pwd)/releases:/output voxtype-onnx-avx512-builder
#
FROM ubuntu:24.04

ARG VERSION=0.6.1
ARG DEBIAN_FRONTEND=noninteractive

ENV VERSION=${VERSION}

# Retry apt. Acquire::Retries covers connection errors; the loop covers a 404
# or a size mismatch while an Ubuntu mirror is mid-sync.
RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\n' \
    > /etc/apt/apt.conf.d/80-voxtype-retries

# Install build dependencies
RUN for attempt in 1 2 3 4; do apt-get update && apt-get install -y \
    curl \
    build-essential \
    clang \
    cmake \
    pkg-config \
    libasound2-dev \
    libx11-dev \
    libxi-dev \
    libxtst-dev \
    libgtk-3-dev \
    libglib2.0-dev \
    libappindicator3-dev \
    libssl-dev \
    protobuf-compiler \
    libprotobuf-dev \
    git \
    binutils \
    python3 \
    libvulkan-dev \
    glslang-tools \
    spirv-tools \
    libshaderc-dev \
    glslc \
    && break; \
    [ "$attempt" = 4 ] && exit 1; \
    echo "apt failed (attempt $attempt), mirror may be syncing; retrying in 90s"; \
    if [ "$attempt" = 2 ]; then echo "switching apt to azure.archive.ubuntu.com"; sed -i -E 's#https?://(archive|security)\.ubuntu\.com#http://azure.archive.ubuntu.com#g' /etc/apt/sources.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true; fi; \
    rm -rf /var/lib/apt/lists/*; sleep 90; \
    done && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build

# Copy source code
COPY . .

# Cross-compile to the x86-64-v4 microarch level (AVX-512F+BW+CD+DQ+VL).
# RUSTFLAGS applied globally crashes host-side build scripts and proc macros
# with SIGILL on a non-AVX-512 builder, so we use the per-target rustflags
# env var plus `--target` so cargo separates host from target compilation.
# See Dockerfile.avx512 for the full rationale.
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-C target-cpu=x86-64-v4"
ENV CFLAGS="-march=x86-64-v4"
ENV CXXFLAGS="-march=x86-64-v4"
ENV TRANSCRIBE_CMAKE_ARGS="-DTRANSCRIBE_USE_SYSTEM_BLAS=OFF -DTRANSCRIBE_X86_CONSERVATIVE=ON -DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON -DGGML_BMI2=ON -DGGML_AVX512=ON -DGGML_AVX512_VBMI=ON -DGGML_AVX512_VNNI=ON"

# ONNX Runtime will be downloaded during build by the ort crate
ENV ORT_STRATEGY=download

# Disable LTO for faster builds
# Build with all ONNX engines plus the GGUF client (see Dockerfile.onnx).
#
# The worker is Vulkan-capable like every x86_64 ONNX variant's. Its build
# drops CFLAGS/CXXFLAGS: ggml-vulkan compiles vulkan-shaders-gen as a host
# tool through ExternalProject, which inherits them from the environment and
# would SIGILL on a non-AVX-512 builder while generating shaders. The worker's
# AVX-512 CPU kernels come from TRANSCRIBE_CMAKE_ARGS, and its Rust code from
# the per-target RUSTFLAGS, so neither depends on CFLAGS.
RUN cargo build --release --target x86_64-unknown-linux-gnu --features parakeet,moonshine,sensevoice,paraformer,dolphin,omnilingual,cohere,openvino-whisper,ml-diarization,gguf,cohere-gguf,parakeet-gguf \
    --config 'profile.release.lto=false' \
    --config 'profile.release.codegen-units=8' \
    && cp target/x86_64-unknown-linux-gnu/release/voxtype /tmp/voxtype-onnx-avx512 \
    && env -u CFLAGS -u CXXFLAGS \
        cargo build --release --target x86_64-unknown-linux-gnu -p voxtype-gguf-worker --features vulkan \
        --config 'profile.release.lto=false' \
        --config 'profile.release.codegen-units=8' \
    && cp target/x86_64-unknown-linux-gnu/release/voxtype-gguf-worker /tmp/voxtype-gguf-worker

# Preserve exact build-stage version evidence for collection on another runner.
# Cross-version metadata is not a claim that AVX-512 executed here.
RUN mkdir -p /tmp/release-proof \
    && cp /tmp/voxtype-onnx-avx512 /tmp/release-proof/voxtype-${VERSION}-linux-x86_64-onnx-avx512 \
    && python3 scripts/release-artifacts.py record-cross \
        /tmp/release-proof/voxtype-${VERSION}-linux-x86_64-onnx-avx512 "${VERSION}" --source /build

# Verify the binary contains AVX-512 instructions. We deliberately do NOT
# run `--version` here: this Docker build runs on the build host's CPU,
# which on a GH-hosted runner usually lacks AVX-512 — executing the
# cross-compiled binary would SIGILL. objdump-based inspection is enough.
RUN echo "=== Checking for AVX-512 instructions ===" \
    && avx512_count=$(objdump -d /tmp/voxtype-onnx-avx512 | grep -cE 'zmm|vpternlog|vpermt2|\{1to' || true) \
    && worker_avx512_count=$(objdump -d /tmp/voxtype-gguf-worker | grep -cE 'zmm|vpternlog|vpermt2|\{1to' || true) \
    && echo "  AVX-512 instructions: $avx512_count" \
    && echo "  Worker AVX-512 instructions: $worker_avx512_count" \
    && if [ "$avx512_count" -eq 0 ] || [ "$worker_avx512_count" -eq 0 ]; then \
         echo "ERROR: ONNX AVX-512 binary contains zero AVX-512 instructions." \
         && echo "  Likely cause: target-cpu and/or march flags reverted to host detection." \
         && exit 1; \
       fi \
    && echo "✓ Binary contains $avx512_count AVX-512 instructions" \
    && scripts/verify-gguf-companion.sh --vulkan \
        /tmp/voxtype-onnx-avx512 /tmp/voxtype-gguf-worker \
    && echo "=== Binary size ===" \
    && ls -lh /tmp/voxtype-onnx-avx512

# Output stage
CMD mkdir -p /output \
    && cp /tmp/voxtype-onnx-avx512 /output/voxtype-${VERSION}-linux-x86_64-onnx-avx512 \
    && cp /tmp/release-proof/voxtype-${VERSION}-linux-x86_64-onnx-avx512.version-proof.json /output/ \
    && cp /tmp/voxtype-gguf-worker /output/voxtype-${VERSION}-linux-x86_64-onnx-avx512.gguf-worker \
    && echo "Binary copied to /output:" \
    && ls -la /output/voxtype-*
