# Build environment for voxtype AVX-512 binary
# MUST be run on a machine with AVX-512 support (Zen 4+, some Intel)
#
# Usage:
#   docker build -f Dockerfile.avx512 -t voxtype-avx512-builder .
#   docker run --rm -v $(pwd)/releases:/output voxtype-avx512-builder
#
FROM ubuntu:22.04

ARG VERSION=0.6.1
ARG DEBIAN_FRONTEND=noninteractive

ENV VERSION=${VERSION}

# Retry apt. Acquire::Retries covers connection errors; the loop covers a 404
# or a size mismatch while an Ubuntu mirror is mid-sync.
RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\n' \
    > /etc/apt/apt.conf.d/80-voxtype-retries

# Install build dependencies
RUN for attempt in 1 2 3 4; do apt-get update && apt-get install -y \
    curl \
    build-essential \
    clang \
    cmake \
    pkg-config \
    libasound2-dev \
    libx11-dev \
    libxi-dev \
    libxtst-dev \
    libgtk-3-dev \
    libglib2.0-dev \
    libappindicator3-dev \
    git \
    binutils \
    python3 \
    && break; \
    [ "$attempt" = 4 ] && exit 1; \
    echo "apt failed (attempt $attempt), mirror may be syncing; retrying in 90s"; \
    rm -rf /var/lib/apt/lists/*; sleep 90; \
    done && rm -rf /var/lib/apt/lists/*

# Install Rust via rustup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build

COPY . .

# Cross-compile the final voxtype binary to x86-64-v4 (AVX-512F+BW+CD+DQ+VL)
# regardless of the build host's CPU. Two cargo nuances make this trickier
# than just setting RUSTFLAGS:
#
#  1. RUSTFLAGS applies to every Rust compilation, including build scripts and
#     proc macros that *execute on the build host* during the build. Forcing
#     AVX-512 globally crashes those host-side binaries with SIGILL on any
#     runner without AVX-512.
#  2. Passing `--target <triple>` to cargo makes it separate host code from
#     target code. Build scripts and proc macros then use host defaults,
#     while only the final crate gets target-specific flags. The
#     CARGO_TARGET_<triple>_RUSTFLAGS env var applies only to the target.
#
# The combination below produces an AVX-512 binary even on a stock ubuntu-22.04
# GitHub-hosted runner (whose CPU is typically Cascade Lake-without-AVX-512
# or older).
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-C target-cpu=x86-64-v4"

# whisper.cpp / ggml is compiled by whisper-rs's build.rs via CMake. CMake
# compiles output objects with these flags but runs its own configure-time
# test binaries (which would SIGILL on a non-AVX-512 host) without them, so
# this is safe.
ENV CFLAGS="-march=x86-64-v4"
ENV CXXFLAGS="-march=x86-64-v4"
ENV WHISPER_CMAKE_ARGS="-DGGML_NATIVE=OFF -DGGML_AVX512=ON -DGGML_AVX512_VBMI=ON -DGGML_AVX512_VNNI=ON"
# The workspace default deliberately caps transcribe.cpp at x86-64-v3.
# This variant promises v4, so compile the GGUF worker's ggml tiers to match.
ENV TRANSCRIBE_CMAKE_ARGS="-DTRANSCRIBE_USE_SYSTEM_BLAS=OFF -DTRANSCRIBE_X86_CONSERVATIVE=ON -DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON -DGGML_BMI2=ON -DGGML_AVX512=ON -DGGML_AVX512_VBMI=ON -DGGML_AVX512_VNNI=ON"

# Every release binary carries the GGUF client (gguf, cohere-gguf,
# parakeet-gguf) so `.gguf` catalog models route to the worker. This variant
# ships a CPU worker; GPU GGUF on Whisper builds comes from the vulkan variant.
RUN cargo build --release --target x86_64-unknown-linux-gnu --features gguf,cohere-gguf,parakeet-gguf \
    && cp target/x86_64-unknown-linux-gnu/release/voxtype /tmp/voxtype-avx512 \
    && cargo build --release --target x86_64-unknown-linux-gnu -p voxtype-gguf-worker \
    && cp target/x86_64-unknown-linux-gnu/release/voxtype-gguf-worker /tmp/voxtype-gguf-worker

RUN scripts/verify-gguf-companion.sh --cpu-only \
        /tmp/voxtype-avx512 /tmp/voxtype-gguf-worker

# Preserve exact build-stage version evidence for collection on another runner.
# Cross-version metadata is not a claim that AVX-512 executed here.
RUN mkdir -p /tmp/release-proof \
    && cp /tmp/voxtype-avx512 /tmp/release-proof/voxtype-${VERSION}-linux-x86_64-avx512 \
    && python3 scripts/release-artifacts.py record-cross \
        /tmp/release-proof/voxtype-${VERSION}-linux-x86_64-avx512 "${VERSION}" --source /build

# Verify AVX-512 instructions ARE present. Fail the build if not, so the
# pipeline never produces a mislabeled binary.
RUN echo "=== Verifying AVX-512 binary and GGUF worker ===" \
    && avx512_count=$(objdump -d /tmp/voxtype-avx512 | grep -cE 'zmm|vpternlog|vpermt2|\{1to' || true) \
    && worker_avx512_count=$(objdump -d /tmp/voxtype-gguf-worker | grep -cE 'zmm|vpternlog|vpermt2|\{1to' || true) \
    && echo "  AVX-512 instructions: $avx512_count" \
    && echo "  Worker AVX-512 instructions: $worker_avx512_count" \
    && if [ "$avx512_count" -eq 0 ] || [ "$worker_avx512_count" -eq 0 ]; then \
         echo "ERROR: AVX-512 binary contains zero AVX-512 instructions." \
         && echo "  Likely cause: target-cpu and/or CMake march flags reverted to host detection." \
         && exit 1; \
       fi \
    && echo "✓ AVX-512 binary contains $avx512_count AVX-512 instructions"

CMD mkdir -p /output \
    && cp /tmp/voxtype-avx512 /output/voxtype-${VERSION}-linux-x86_64-avx512 \
    && cp /tmp/release-proof/voxtype-${VERSION}-linux-x86_64-avx512.version-proof.json /output/ \
    && cp /tmp/voxtype-gguf-worker /output/voxtype-${VERSION}-linux-x86_64-avx512.gguf-worker \
    && echo "Binary copied to /output:" \
    && ls -la /output/voxtype-*-avx512
