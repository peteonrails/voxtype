# Build environment for the voxtype baseline x86-64 binary.
#
# WHY THIS EXISTS: every other x86-64 variant is built with
# `-C target-cpu=haswell` or higher, so all of them SIGILL on a CPU without
# AVX2. That is not a hypothetical: #612 came from a 2012 MacBook Pro with an
# Ivy Bridge i5-3210M, which has `avx` and `f16c` but no `avx2`, `fma` or
# `bmi2`. Before this variant existed, the honest advice to those users was
# "build it yourself".
#
# The floor is x86-64-v2 (SSE4.2 + POPCNT, Nehalem 2008 and later) rather than
# plain x86-64. It reaches every machine that could plausibly run a modern
# Linux desktop and is meaningfully faster than true baseline. Going lower buys
# hardware nobody is running voxtype on.
#
# Ubuntu 22.04 for the same reason as Dockerfile.build: newer distros ship a
# libstdc++ whose inlined templates leak AVX-512 into binaries regardless of
# RUSTFLAGS.
#
# Usage:
#   docker build -f Dockerfile.baseline -t voxtype-baseline .
#   docker run --rm -v $(pwd)/releases:/output voxtype-baseline
#
FROM ubuntu:22.04

ARG VERSION=1.1.0
ARG DEBIAN_FRONTEND=noninteractive
ENV VERSION=${VERSION}

RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    clang \
    cmake \
    pkg-config \
    libasound2-dev \
    libx11-dev \
    libxi-dev \
    libxtst-dev \
    libgtk-3-dev \
    libglib2.0-dev \
    libappindicator3-dev \
    git \
    binutils \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build
COPY . .

# The whole point of the variant. GGML_NATIVE=OFF stops ggml probing the build
# host, and every SIMD level above the floor is turned off explicitly rather
# than left to CMake's detection, because detection reads the builder's CPU.
ENV RUSTFLAGS="-C target-cpu=x86-64-v2 -C target-feature=-avx2,-fma,-bmi2,-avx512f,-avx512bw,-avx512cd,-avx512dq,-avx512vl,-gfni"
ENV GGML_NATIVE=OFF
ENV GGML_AVX=OFF
ENV GGML_AVX2=OFF
ENV GGML_FMA=OFF
ENV GGML_F16C=OFF
ENV GGML_AVX512=OFF
ENV GGML_AVX_VNNI=OFF
ENV GGML_AVX512_VNNI=OFF
ENV CMAKE_C_FLAGS="-march=x86-64-v2 -mno-avx -mno-avx2 -mno-fma -mno-f16c -mno-bmi2 -mno-avx512f -mno-gfni -mno-avxvnni"
ENV CMAKE_CXX_FLAGS="-march=x86-64-v2 -mno-avx -mno-avx2 -mno-fma -mno-f16c -mno-bmi2 -mno-avx512f -mno-gfni -mno-avxvnni"

RUN cargo build --release \
    && cp target/release/voxtype /tmp/voxtype-baseline

# Verification is stricter here than for the other variants. Those only assert
# "no AVX-512"; this one has to assert "no AVX2 either", which is the property
# the variant exists to provide. A baseline binary that contains a single vpaddd
# on a ymm register is worse than useless: it SIGILLs on exactly the machines it
# was built for, and does so without the SIGILL handler being able to say
# anything more useful than it already does.
RUN echo "=== Verifying baseline binary ===" \
    && zmm=$(objdump -d /tmp/voxtype-baseline | grep -c zmm || echo 0) \
    && ymm=$(objdump -d /tmp/voxtype-baseline | grep -c ymm || echo 0) \
    && avx2=$(objdump -d /tmp/voxtype-baseline | grep -cE 'vpbroadcast|vperm2i128|vpgather|vinserti128' || echo 0) \
    && fma=$(objdump -d /tmp/voxtype-baseline | grep -cE 'vfmadd|vfmsub|vfnmadd' || echo 0) \
    && bmi=$(objdump -d /tmp/voxtype-baseline | grep -cE 'shlx|shrx|sarx|rorx|mulx|pdep|pext' || echo 0) \
    && echo "  zmm (AVX-512): $zmm" \
    && echo "  ymm (AVX/AVX2): $ymm" \
    && echo "  AVX2-only ops:  $avx2" \
    && echo "  FMA:            $fma" \
    && echo "  BMI1/2:         $bmi" \
    && if [ "$zmm" -gt 0 ] || [ "$ymm" -gt 0 ] || [ "$avx2" -gt 0 ] || [ "$fma" -gt 0 ] || [ "$bmi" -gt 0 ]; then \
         echo "ERROR: baseline binary contains instructions a pre-Haswell CPU cannot execute!" && exit 1; \
       fi \
    && echo "✓ baseline binary runs on x86-64-v2"

CMD mkdir -p /output \
    && cp /tmp/voxtype-baseline /output/voxtype-${VERSION}-linux-x86_64-baseline \
    && chmod 755 /output/voxtype-${VERSION}-linux-x86_64-baseline \
    && echo "Binary copied to /output:" \
    && ls -la /output/voxtype-*
